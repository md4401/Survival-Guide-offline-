{
  "name": "survival-guide-offline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content && vite",
    "content": "tsx scripts/build-countries.ts && tsx scripts/build-content.ts",
    "validate": "tsx scripts/validate-content.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "build": "npm run validate && npm run check:i18n && npm run check:css && npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "size": "tsx scripts/size-report.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e/offline.mjs",
    "check:css": "tsx scripts/check-css.ts",
    "verify": "npm run build && npm test && npm run eval:ai && npm run size && npm run test:e2e",
    "cap:sync": "npm run build && cap sync",
    "icons": "node scripts/gen-icons.mjs",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "shots": "node scripts/store-shots.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "dexie": "^4.4.7",
    "minisearch": "^7.2.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "countries-and-timezones": "^3.11.0",
    "country-json": "^2.3.0",
    "emergency-numbers": "^1.0.2",
    "fake-indexeddb": "^6.2.8",
    "gray-matter": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "world-countries": "^5.1.0"
  }
}
