<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy: nothing the user saves (notes, family plan, messages, AI models) is copied to cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
