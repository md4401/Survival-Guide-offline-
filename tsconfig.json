{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "jsxImportSource": "preact",
    "strict": true, "skipLibCheck": true, "resolveJsonModule": true,
    "esModuleInterop": true, "isolatedModules": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"],
    "paths": { "react": ["./node_modules/preact/compat"], "react-dom": ["./node_modules/preact/compat"] }
  },
  "include": ["src", "scripts", "tests", "vite.config.ts", "capacitor.config.ts"]
}
